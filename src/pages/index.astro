---
import Layout from "../layouts/Layout.astro";

import { projects } from "../attributes/projects";
import { skills } from "../attributes/skills";
import { contact } from "../attributes/contact";
---

<Layout title="Will Jackson | Web developer and WordPress specialist">
	<div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
		<!-- Hero -->

		<!-- Columns
		<section
			class="grid min-h-[70vh] items-center gap-12 py-12 lg:grid-cols-[1.2fr_0.8fr]"
		>
		-->

		<section>
			<div class="p-8 border rounded-lg border-stone-400">
				<h1
					class="max-w-4xl font-heading text-5xl font-semibold tracking-tight sm:text-6xl lg:text-7xl"
				>
					Web developer and WordPress specialist based in Surrey.
				</h1>

				<p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-600">
					I build practical, commercially useful websites and tools
					using WordPress, WooCommerce, PHP, JavaScript and modern
					frontend workflows.
				</p>

				<div class="mt-8 flex flex-wrap gap-4">
					<a
						class="inline-flex rounded-lg border border-teal-900 bg-teal-900 px-6 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:shadow-md"
						href="#work"
					>
						View work
					</a>

					<a
						class="inline-flex rounded-lg border border-teal-900 px-6 py-3 font-bold text-teal-700 transition hover:-translate-y-0.5 hover:shadow-md"
						href="#contact"
					>
						Contact me
					</a>
				</div>
			</div>
		</section>

		<!-- Selected work -->
		<section id="work" class="py-12">
			<h2
				class="font-heading text-4xl font-bold tracking-tight text-teal-900"
			>
				Selected work
			</h2>

			<div
				id="projects"
				class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3"
			>
				{
					projects.map((project) => (
						<article class="flex h-full flex-col overflow-hidden rounded-lg border border-stone-400 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
							{project.image && project.imageAlt && (
								<div class="bg-stone-100 p-3">
									<div class="overflow-hidden rounded-lg border border-stone-400 bg-white">
										<div class="flex gap-1.5 border-b border-stone-200 bg-stone-50 px-3 py-2">
											<span class="h-2.5 w-2.5 rounded-full bg-stone-300" />
											<span class="h-2.5 w-2.5 rounded-full bg-stone-300" />
											<span class="h-2.5 w-2.5 rounded-full bg-stone-300" />
										</div>

										<div class="w-full overflow-hidden bg-stone-100 aspect-16/9">
											<img
												src={project.image.src}
												alt={project.imageAlt}
												class="zoomable-img h-auto w-full"
												loading="lazy"
											/>
										</div>
									</div>
								</div>
							)}

							<div class="flex flex-1 flex-col p-6">
								<div class="flex items-start justify-between gap-4">
									<h3 class="font-heading text-2xl font-bold text-neutral-950">
										{project.title}
									</h3>

									{project.status === "in-development" && (
										<span class="text-nowrap rounded-full bg-stone-100 px-3 py-1 text-xs font-bold text-teal-900">
											In development
										</span>
									)}

									{project.status === "internal" && (
										<span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-bold text-teal-900">
											Internal
										</span>
									)}
								</div>

								<p class="mt-2 font-bold text-stone-700">
									{project.meta}
								</p>

								<p class="mt-4 text-neutral-600">
									{project.description}
								</p>

								<a
									class="mt-auto pt-5 font-bold text-teal-900 hover:underline"
									href={project.link}
								>
									{project.linkText} →
								</a>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- Technical skills -->
		<section class="py-12">
			<h2
				class="font-heading text-4xl font-bold tracking-tight text-teal-900"
			>
				Technical skills
			</h2>

			<div class="mt-8 grid gap-6 lg:grid-cols-2">
				<div
					class="rounded-lg border border-stone-400 bg-white p-6 shadow-sm"
				>
					{
						skills.slice(0, 2).map((group, index) => (
							<div
								class:list={[
									"grid gap-2 py-5 sm:grid-cols-[180px_1fr]",
									index !== 0 && "border-t border-stone-200",
									index === 0 && "pt-0",
									index === 1 && "pb-0",
								]}
							>
								<strong>{group.title}</strong>
								<span class="text-neutral-600">
									{group.skills}
								</span>
							</div>
						))
					}
				</div>

				<div
					class="rounded-lg border border-stone-400 bg-white p-6 shadow-sm"
				>
					{
						skills.slice(2).map((group, index) => (
							<div
								class:list={[
									"grid gap-2 py-5 sm:grid-cols-[180px_1fr]",
									index !== 0 && "border-t border-stone-200",
									index === 0 && "pt-0",
									index === 1 && "pb-0",
								]}
							>
								<strong>{group.title}</strong>
								<span class="text-neutral-600">
									{group.skills}
								</span>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- About -->
		<section id="about" class="py-12">
			<h2
				class="font-heading text-4xl font-bold tracking-tight text-teal-900"
			>
				About
			</h2>

			<div class="mt-6 space-y-4 text-lg leading-8 text-neutral-600">
				<p>
					I’m a web developer based in Surrey, currently working as
					the main technical person for an independent flooring
					retailer. My work covers WordPress development, WooCommerce
					catalogue management, technical SEO, analytics, hosting,
					performance and internal tools.
				</p>

				<p>
					Before moving into web development, I worked in legal and
					administrative roles, which gave me a careful,
					process-driven approach and strong attention to detail. I’m
					particularly interested in practical websites that are fast,
					maintainable and genuinely useful to the people who manage
					them.
				</p>
			</div>
		</section>

		<!-- Contact -->
		<section id="contact" class="py-12">
			<h2
				class="font-heading text-4xl font-bold tracking-tight text-teal-900"
			>
				Contact
			</h2>

			<p class="mt-4 text-lg text-neutral-600">
				If you’d like to talk about a role or project, I’d be glad to
				hear from you.
			</p>

			<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					contact.map((link) => (
						<a
							class="rounded-lg border border-stone-400 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
							href={link.href}
							target="_blank"
						>
							<span class="block font-bold text-teal-900">
								{link.label}
							</span>
							<span class="mt-1 block break-words text-neutral-950">
								{link.text}
							</span>
						</a>
					))
				}
			</div>
		</section>
	</div>
</Layout>
